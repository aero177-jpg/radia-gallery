{
  "id": "./",
  "name": "Radia",
  "short_name": "Radia",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "background_color": "#0c0d10",
  "theme_color": "#0c0d10",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [".ply", ".sog"]
      },
      "launch_type": "single-client"
    }
  ],
  "icons": [
    {
      "sizes": "192x192",
      "src": "radiaIcon_192.png",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "sizes": "512x512",
      "src": "radiaIcon_512.png",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
