{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radia",
  "version": "1.0.0",
  "identifier": "com.modelsharp.radia",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Radia",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["ply"],
        "name": "Radia Gaussian Splat",
        "description": "3D Gaussian Splat file",
        "role": "Editor"
      },
      {
        "ext": ["sog"],
        "name": "Radia SOG Splat",
        "description": "Compressed 3D Gaussian Splat file",
        "role": "Editor"
      }
    ]
  }
}